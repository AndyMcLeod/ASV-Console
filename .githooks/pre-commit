#!/bin/sh
# Pre-commit: run the geometry regression tests whenever the source they cover is
# staged, so a commit can't silently regress the ASV's obstacle-avoidance / Rule 9
# handedness or its survey turn geometry. Both are fast (~1 s each), stdlib Node.
#
#   tests/buoy_lane.js      Rule 9 channel lane - which side of a channel the ASV
#                           rides, marked and unmarked, both directions.
#   tests/turn_geometry.js  survey line-to-line turns - shape selection, the minimum
#                           turn radius held along the WHOLE path, exit alignment,
#                           outboard excursion, nogo refusal.
#   tests/roc_tracks.py     ROC arrival geometry, the staged/active HOME gate, moving
#                           HOME, NMEA validation, and the VESSEL-DERIVED defaults.
#   tests/end_action.js     what the vessel-status and Mission cards say a run does at
#                           its end - an end-of-plan RTH must show BEFORE it fires.
#   tests/nogo_readout.js   the Nogo row's state: that it stops reading once the extract
#                           lands, and that "no chart" never reads as "clear water".
#   tests/pattern_move_grip.js  the survey whole-move grip: reachable by hit test AND
#                           drawn above the boat marker that used to bury it.
#   tests/survey_card.js    the survey card keeps describing a COMMITTED plan instead
#                           of blanking when the pattern anchors are dropped.
#   tests/speed_recalc.js   the plan speed is an INPUT: changing it recalculates, and a
#                           committed plan is re-checked against the new turn radius.
#   tests/live_speed.py     the commanded speed REACHES the vessel: speed over ground
#                           follows a live change. Drives a real console.
#   tests/ais_range.py      the AIS display range FILTERS a wide subscription, is a true
#                           range circle, and is never applied on a lake.
#   tests/ui_split.js       the two-window registration lists resolve, and the vessel
#                           card stays on the CHART window only.
#   tests/panel_drag.js     ONE drag mechanism for every floating pop-out, and no panel
#                           forgetting where the operator put it.
#   tests/stored_settings.js  the guarded localStorage helpers - blocked storage never
#                           throws, and toggles saved as legacy "1"/"0" still read.
#   tests/http_contract.py  the two OPPOSITE handler contracts: POST returns (code, obj),
#                           GET commits its own response. Every request gets exactly one
#                           answer and the server survives it. Routes parsed from source.
#
# Ported from the sibling console 2026-07-31. Everything browser-side lives in ONE
# file here (static/asv.html - there is no routing.js split), so the path filter is
# shorter than the sibling's.
#
# Activated by  git config core.hooksPath .githooks  (run once per clone; see
# README / the hook's own note). Bypass in a pinch with:  git commit --no-verify

# Only bother when a source the tests cover, or ANY test, is staged.
# The test half of this filter used to name each suite individually and had drifted:
# five suites (wreck_clearance, water_trust, ais_range, live_speed, completion_modes)
# were never listed, so editing one of them ALONE ran nothing. A hand-maintained list
# beside a directory that already answers the question is the same "one mechanism, not
# two" trap as the panels - `tests/` covers every suite, including ones not yet written.
changed=$(git diff --cached --name-only)
case "$changed" in
  *static/asv.html*|*roc_tracks.py*|*asv_console.py*|*ais_service.py*|*tests/*) ;;
  *) exit 0 ;;
esac

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found - skipping geometry tests (install Node to enable them)."
  exit 0
fi

# Run BOTH, and report every failure rather than stopping at the first - two broken
# invariants are worth knowing about in one pass.
fail=0

echo "pre-commit: buoy-lane handedness regression test..."
if ! node tests/buoy_lane.js; then
  echo ""
  echo "pre-commit: buoy-lane test FAILED."
  echo "  The route search changed the Rule 9 handedness (centreline no longer to port)."
  echo "  Fix channelLaneRoute in static/asv.html."
  fail=1
fi

echo "pre-commit: charted point-hazard extent regression test..."
if ! node tests/wreck_clearance.js; then
  echo ""
  echo "pre-commit: wreck-clearance test FAILED."
  echo "  A charted wreck / obstruction is no longer keeping a route off it, or the"
  echo "  vessel's nogo buffer floor leaked (hazExtent / blocked / rasterKeepouts)."
  fail=1
fi

echo "pre-commit: water-level trust regression test..."
if ! node tests/water_trust.js; then
  echo ""
  echo "pre-commit: water-trust test FAILED."
  echo "  A tide reading from far away would no longer be flagged as such"
  echo "  (waterTrust / WATER_FAR_KM / WATER_REMOTE_KM in static/asv.html)."
  fail=1
fi

echo "pre-commit: speed recalculation regression test..."
if ! node tests/speed_recalc.js; then
  echo ""
  echo "pre-commit: speed-recalc test FAILED."
  echo "  Changing the plan speed no longer recalculates, or a committed plan is not"
  echo "  re-checked against the turn radius the new speed implies"
  echo "  (recalcForSpeed / recalcCommittedForSpeed in static/asv.html)."
  fail=1
fi

echo "pre-commit: UI split regression test..."
if ! node tests/ui_split.js; then
  echo ""
  echo "pre-commit: ui-split test FAILED."
  echo "  A window-split registration selector no longer resolves, or the vessel-status"
  echo "  card has been mirrored back into the controls window / stripped from the chart"
  echo "  window (UI_BRIDGED / UI_CARD_TITLES / the injected CSS in static/asv.html)."
  fail=1
fi

echo "pre-commit: stored settings regression test..."
if ! node tests/stored_settings.js; then
  echo ""
  echo "pre-commit: stored-settings test FAILED."
  echo "  A stored setting no longer survives blocked or full storage, a toggle saved by"
  echo "  an older build as \"1\"/\"0\" no longer reads, or a bare localStorage call has"
  echo "  crept back in beside the helpers (lsGet / lsSet / lsDel / lsBool)."
  fail=1
fi

echo "pre-commit: panel drag regression test..."
if ! node tests/panel_drag.js; then
  echo ""
  echo "pre-commit: panel-drag test FAILED."
  echo "  A floating pop-out has grown its own private drag again beside the shared"
  echo "  mechanism, lost the key that remembers where it was put, or stopped releasing"
  echo "  its bottom/right anchor (makeDraggablePanel in static/asv.html)."
  fail=1
fi

echo "pre-commit: survey card regression test..."
if ! node tests/survey_card.js; then
  echo ""
  echo "pre-commit: survey-card test FAILED."
  echo "  The survey card blanks on a committed plan again, or its derived figures"
  echo "  disagree with mission.lines (committedPatternInfo in static/asv.html)."
  fail=1
fi

echo "pre-commit: survey move-grip regression test..."
if ! node tests/pattern_move_grip.js; then
  echo ""
  echo "pre-commit: move-grip test FAILED."
  echo "  The survey pattern's whole-move grip is unreachable again - drawn inside"
  echo "  drawPattern() where the boat marker covers it, no longer named in the SURV"
  echo "  hint, or losing its hit-test tie-break (drawPatMoveGrip / patHandleAt)."
  fail=1
fi

echo "pre-commit: nogo readout regression test..."
if ! node tests/nogo_readout.js; then
  echo ""
  echo "pre-commit: nogo-readout test FAILED."
  echo "  The Nogo row no longer names its state - it is stuck reading after a"
  echo "  successful extract, or 'no chart' and 'clear water' have been conflated"
  echo "  (nogoReadout / updateNogoUI / refreshNogo in static/asv.html)."
  fail=1
fi

echo "pre-commit: end-action readout regression test..."
if ! node tests/end_action.js; then
  echo ""
  echo "pre-commit: end-action test FAILED."
  echo "  The cards no longer name where the run leaves the boat - an end-of-plan RTH"
  echo "  is being hidden behind a 'loiter', or promised where the chain cannot fire"
  echo "  (rthPending / endAction in static/asv.html)."
  fail=1
fi

echo "pre-commit: survey turn geometry regression test..."
if ! node tests/turn_geometry.js; then
  echo ""
  echo "pre-commit: turn-geometry test FAILED."
  echo "  A survey reversal no longer ends on the next line aligned, or asks the boat"
  echo "  to hold a radius tighter than it can (teardropTurn in static/asv.html)."
  fail=1
fi

if command -v python >/dev/null 2>&1; then
  echo "pre-commit: ROC / moving-HOME regression test..."
  if ! python tests/roc_tracks.py; then
    echo ""
    echo "pre-commit: ROC test FAILED."
    echo "  A recovery point no longer lands where the offset says, the staged/active"
    echo "  HOME gate leaks, or a vessel-derived default stopped tracking the vessel"
    echo "  (roc_tracks.py)."
    fail=1
  fi
  echo "pre-commit: AIS range regression test..."
  if ! python tests/ais_range.py; then
    echo ""
    echo "pre-commit: AIS-range test FAILED."
    echo "  The display range no longer filters the collected area correctly - filtering"
    echo "  by box rather than range circle, filtering a LAKE, or letting the radius"
    echo "  exceed what was collected (/api/ais + /api/ais/radius in asv_console.py)."
    fail=1
  fi
  echo "pre-commit: live speed regression test..."
  if ! python tests/live_speed.py; then
    echo ""
    echo "pre-commit: live-speed test FAILED."
    echo "  A speed change is not reaching the vessel - speed over ground no longer"
    echo "  follows the commanded speed (SimVcu.set_speed / Engine.set_speed /"
    echo "  /api/cmd/speed in asv_console.py)."
    fail=1
  fi
  echo "pre-commit: end-of-plan completion regression test..."
  if ! python tests/completion_modes.py; then
    echo ""
    echo "pre-commit: completion-modes test FAILED."
    echo "  The operator's END-OF-PLAN SETTING and the completion of the run IN"
    echo "  PROGRESS have been conflated again - a behaviour is writing the setting,"
    echo "  or a plan run is ignoring it (plan_completion / Engine.run_completion)."
    fail=1
  fi
  echo "pre-commit: HTTP contract regression test..."
  if ! python tests/http_contract.py; then
    echo ""
    echo "pre-commit: http-contract test FAILED."
    echo "  A POST handler is breaking _dispatch_post's (code, obj) contract, a GET"
    echo "  handler has a path that commits NO response, or something raised while"
    echo "  serving. Note a handler can answer the client CORRECTLY and still take"
    echo "  down its thread - _send writes the response before the caller unpacks -"
    echo "  so check 16 (the server's own log) is the one no client check can see."
    fail=1
  fi
else
  echo "pre-commit: python not found - skipping the ROC and completion tests."
fi

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "pre-commit: commit blocked. Override with:  git commit --no-verify"
  exit 1
fi
exit 0
