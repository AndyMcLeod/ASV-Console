    planner_guard_seam.js) echo "  THE PLANNER AND THE GUARD HAVE STOPPED AGREEING ABOUT ONE NUMBER (Andy, 2026-09-19, item 3: the planner clips to what the guard needs). The standoff is guardStandoffM in static/js/guard.js, DERIVED from that rung's own HELM_S and HELM_ENTRY_FRAC and floored at the operator's buffer, and patClipBufM in the page must CALL it rather than re-derive it - two numbers meant to agree, kept in two files, is the seam itself. Watch for: the buffer floor going (calm water would silently narrow every survey anyone has ever planned, check 2); the page arithmetic-ing its way to the same answer instead of importing (check 6); punchOut clipping at the bare `buffer` again (check 5); the standoff dropping out of patStrikeKey, which hands a punch in one set the clip taken in another (check 5b); and the card going quiet about it (check 8) - clipping coverage at more than the operator asked for COSTS them survey and this console says that kind of thing out loud. Checks 3 and 4 are the tie to the guard and must move together: a line AT the standoff is not in extremis and a line inside it is. ⚠ SINCE 2026-09-26 THE LEADS AND THE TURNS TAKE THE STANDOFF TOO (7, 7b): extendLead, every turnWithRetry, every judgeJoin and the red-join diagnostic read clipBuf - his 09:38 New Castle record had the promise 'not on a line' kept and the boat escaped from the turn at the end of it (91 of 207 turn legs inside 19.5 m; helm 115x in the turns against 28x on the lines). Hops and transits (legSafeAt / routeAround at clipBuf in the punch; routePlan / planNogoRoute with standoffM from patClipBufM) try the standoff FIRST and fall back to the plain buffer only where the water will not allow it, counted and said (nHopInside on the card, insideStandoff in the banners) - the live check's second run was escaped from an approach detour 9.9 m off Fort Point; 7c drives routePlan both ways through state.js; 7b is the tie to the guard for a TURN and its control is the buffer-built arc reading helm AND 7e (2026-09-27): a resume's rejoin point is a FLY-THROUGH target (flyThrough: true at the three way-in sites - resumeFromHere, resumeHeldRun, aisAroundRunning), judged at the buffer and never as a berth; holdTarget's berth test (the 6 m margin, the hold disc) moved a point a standoff beyond a contact's ring off the line and refused the way round on the first live rehearsal. AND 7f (2026-09-28): a route found at the standoff KEEPS it through the lane pass (keepStandoff in passage.js) - every leg at least 19.5 m off a hull-sized block in three orientations, where the lane pass at the buffer cut it to 6-14 m - and a calm route stays at the buffer. AND 7g-7h (2026-09-28): the Upload router (routePlan) too, for a pure transit and a plan's approach; a leg found only at the buffer keeps its Rule 9 lane (a 30 m channel), and where the centerline keeps the standoff and the lane does not (a 40 m channel) she runs the centerline and the lane reads PARTIAL. AND 7 (2026-09-29): the routed way back onto station (reapproachIfSetOff) routes through koWithAis() - the contacts are in the disc it answers, so they are in its route." ;;
    precommit_hook.py)  echo "  The commit gate itself has a gap again (review #17): the staged-path check must skip only when every staged file is Markdown or git metadata; a suite that hangs must be stopped after SUITE_LIMIT_S and block the commit as TIMED OUT; advice_for must hold ONE entry per suite, and one for every suite; and tests/lib/server_log.py must flag tracebacks, socketserver's handler report and '[http] ... raised:' lines - never a deliberate note that happens to name an error." ;;
    *)                 echo "  See the suite's own docstring for what it guards and how to fix it." ;;
  esac
}

fail=0
have_node=0; command -v node   >/dev/null 2>&1 && have_node=1
have_py=0;   command -v python >/dev/null 2>&1 && have_py=1
[ "$have_node" -eq 1 ] || echo "pre-commit: node not found - skipping the JavaScript suites (install Node to enable them)."
[ "$have_py"   -eq 1 ] || echo "pre-commit: python not found - skipping the Python suites."

# A TIME LIMIT PER SUITE (review #17). A suite that hangs - a console that never answers, a promise that never
# settles - used to hold the commit for ever with nothing on screen but its name. GNU timeout stops it after
# SUITE_LIMIT_S (ASV_SUITE_LIMIT_S overrides; the longest suite takes about two minutes) and it is reported as
# TIMED OUT, which blocks the commit like any failure. Without GNU timeout the suites still run, unlimited, and
# the hook says so.
SUITE_LIMIT_S=${ASV_SUITE_LIMIT_S:-600}
# THE LIMIT IS ENFORCED BY tests/lib/limit.py, NOT BY GNU timeout, WHERE THERE IS A PYTHON (2026-09-26). MSYS
# timeout stopped being prompt on this machine: it killed the suite at the limit and then returned ~45 s
# later, for python and node alike (measured; see limit.py's docstring), which is a gate that holds the
# commit for 45 s per hung suite and failed its own check (tests/precommit_hook.py 4). Python's subprocess
# wait returns the moment the child is gone, and limit.py stops the suite's whole process tree. The runner
# is found beside THIS hook, not in the working directory, so the hook's own suite - which runs it in a
# temporary repo holding one probe - runs the real one.
limit=""
HOOK_DIR=$(cd "$(dirname "$0")" && pwd)
if [ "$have_py" -eq 1 ] && [ -f "$HOOK_DIR/../tests/lib/limit.py" ]; then
  limit="python $HOOK_DIR/../tests/lib/limit.py $SUITE_LIMIT_S"
elif timeout --version 2>/dev/null | grep -q GNU; then
  limit="timeout $SUITE_LIMIT_S"
else
  echo "pre-commit: neither python nor GNU timeout found - the suites run without a time limit."
fi

# Run EVERY suite and report every failure rather than stopping at the first - two broken
# invariants are worth knowing about in one pass. A suite that CRASHES is treated exactly
# as loudly as one that fails a check: a non-zero exit is a non-zero exit, and "printed no
# FAIL line" must never read as "passed".
for suite in tests/*.js tests/*.py; do
  [ -e "$suite" ] || continue
  name=$(basename "$suite")
  case "$suite" in
    *.js) [ "$have_node" -eq 1 ] || continue; runner=node   ;;
    *.py) [ "$have_py"   -eq 1 ] || continue; runner=python ;;
  esac
  echo "pre-commit: $name ..."
  $limit $runner "$suite"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    echo ""
    if [ -n "$limit" ] && [ "$rc" -eq 124 ]; then
      echo "pre-commit: $name TIMED OUT after $SUITE_LIMIT_S s - a suite that hangs blocks the commit like one that fails."
    else
      echo "pre-commit: $name FAILED."
    fi
    advice_for "$name"
    fail=1
  fi
done

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "pre-commit: commit blocked. Override with:  git commit --no-verify"
  exit 1
fi
exit 0
