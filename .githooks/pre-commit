#!/bin/sh
# Pre-commit: run the regression suites whenever a source they cover, or any suite
# itself, is staged - so a commit can't silently regress the ASV's obstacle avoidance,
# its Rule 9 handedness, its survey turn geometry, its safety chain or its readouts.
#
# THE SUITE LIST IS DERIVED FROM tests/, NEVER WRITTEN DOWN HERE. This file used to
# carry the names in three places - a header comment, the staged-path filter and the
# run block - and ALL THREE drifted:
#   * the path filter named suites individually and had never listed five of them
#     (wreck_clearance, water_trust, ais_range, live_speed, completion_modes), so
#     editing one of those ALONE ran nothing. Replaced with `tests/`.
#   * the header comment documented seventeen suites while the hook ran twenty.
#   * the run block had to be edited by hand for every new suite, so a suite written
#     and not registered here would never run in anger.
# All three are gone: the loop below globs tests/ and a NEW SUITE IS RUN THE DAY IT IS
# WRITTEN. This is the same "a hand-maintained list beside a directory that already
# answers the question will drift" trap as the pop-out panel copies and the suite
# counts in CLAUDE.md. Read each suite's own docstring for what it guards.
#
# What is NOT derived is the failure ADVICE: each suite gets a line naming the code to
# look at, because "panel_drag failed" is worth much less than "a pop-out grew its own
# private drag again". Those live in advice_for() and are looked up by basename; a suite
# with no entry still RUNS and reports, it just gets the generic message. Missing advice
# is a cosmetic gap - a missing RUN is a hole, which is why only the advice is manual.
#
# Ported from the sibling console 2026-07-31. Everything browser-side lives in ONE file
# here (static/asv.html - there is no routing.js split).
#
# Activated by  git config core.hooksPath .githooks  (run once per clone; see
# README / the hook's own note). Bypass in a pinch with:  git commit --no-verify

# Only bother when a source the tests cover, or ANY test, is staged.
changed=$(git diff --cached --name-only)
case "$changed" in
  # `static/*` (not just asv.html) so the EXTRACTED ES MODULES are covered: static/js/*.js
  # now holds the geodesy, units, geometry and shared-state the page imports, and naming
  # the page alone would let a change to those run nothing - the exact drift this filter
  # was rewritten to remove the first time.
  *static/*|*roc_tracks.py*|*asv_console.py*|*ais_service.py*|*gps_sim.py*|*tests/*|*tools/*|*docs/*) ;;
  *) exit 0 ;;
esac

# Per-suite advice. A suite absent from this list still runs - it just gets the default.
advice_for() {
  case "$1" in
    buoy_lane.js)      echo "  The route search changed the Rule 9 handedness (centreline no longer to port). Fix channelLaneRoute in static/asv.html." ;;
    wreck_clearance.js) echo "  A charted wreck / obstruction no longer keeps a route off it, or the vessel's nogo buffer floor leaked (hazExtent / blocked / rasterKeepouts)." ;;
    water_trust.js)    echo "  A tide reading from far away would no longer be flagged as such (waterTrust / WATER_FAR_KM / WATER_REMOTE_KM in static/asv.html)." ;;
    speed_recalc.js)   echo "  Changing the plan speed no longer recalculates, or a committed plan is not re-checked against the turn radius the new speed implies (recalcForSpeed)." ;;
    ui_tooltips.js)    echo "  The hover-tip layer broke: tipPos lost its flip/clamp (the pointer can occlude the tip again), the stash stopped suppressing the native tip (two tips at once), the restore stopped guarding for mid-hover title writers, or moving within a control kills its tip (the [title] delegation block in static/asv.html - CRLF file)." ;;
    ui_split.js)       echo "  A window-split registration selector no longer resolves, or the vessel-status card has been mirrored back into the controls window (UI_BRIDGED / UI_CARD_TITLES)." ;;
    stored_settings.js) echo "  A stored setting no longer survives blocked or full storage, a toggle saved by an older build as \"1\"/\"0\" no longer reads, or a bare localStorage call crept back in (lsGet / lsSet / lsDel / lsBool)." ;;
    ais_table.js)      echo "  The traffic list is being REBUILT rather than patched - that resets the card's scroll position mid-read and drops a text selection every poll (renderAisTable / setCellText)." ;;
    measure_tool.js)   echo "  The chart ruler or its right-click menu broke: the label stopped flowing along the leg (rotated past 90 deg, so it reads upside-down) or stopped going through fmtDist (so it no longer follows the DIST pill), the click-move-click gesture is reading a PAN-drag as a measurement (the measure branch must stay BELOW the 'moved > 5' guard in the window mouseup), a right-click is commanding the chart again (mousedown's 'e.button !== 0' guard), or a menu row re-derived a vessel gate instead of reading its owning button's .disabled - cmGate is meant to be the reason there is only ONE copy of 'armed and not E-STOPped' (measLabel / drawMeasureLeg / openChartMenu in static/asv.html)." ;;
    panel_drag.js)     echo "  A floating pop-out grew its own private drag again beside the shared mechanism, lost the key that remembers where it was put, or stopped releasing its bottom/right anchor (makeDraggablePanel / showPanel / clampPanelPos)." ;;
    survey_card.js)    echo "  The survey card blanks on a committed plan again, or its derived figures disagree with mission.lines (committedPatternInfo in static/asv.html)." ;;
    pattern_move_grip.js) echo "  The survey pattern's whole-move grip is unreachable again - drawn where the boat marker covers it, or losing its hit-test tie-break (drawPatMoveGrip / patHandleAt)." ;;
    nogo_readout.js)   echo "  The Nogo row no longer names its state - stuck reading after a successful extract, or 'no chart' conflated with 'clear water' (nogoReadout / updateNogoUI)." ;;
    end_action.js)     echo "  The cards no longer name where the run leaves the boat - an end-of-plan RTH hidden behind a 'loiter', or promised where the chain cannot fire (rthPending / endAction)." ;;
    speed_modes.js)    echo "  Speed by ROLE broke. A survey run is three jobs - coverage, turns, transits - and each has its own selectable speed; the console GOVERNS which is live as the run moves between them. Watch for: the role being re-derived instead of read off runLineIdx/curTurn (a second classifier drifts from the one that bills the time, and then the speed the boat runs and the activity the recorder logs describe different moments); the governor writing mission.speeds (that is the OPERATOR'S setting - mission.speed beside it is what the boat is commanded NOW, two fields on purpose, the completion-field lesson one over); the clearance guard's override being ignored (safety outranks the role - while it holds the boat slow the governor stands off); commanding every frame rather than on change; commanding at all when the boat is not under autonomous command; and a heading ever being commanded - the console slows and NEVER steers. ⚠ The TURN radius is derived from the TURN speed (check 10): a hull holds v/omega, so a reversal must be built at the speed it is flown at (speedRole / roleSpeed / speedGovernor in static/asv.html, _norm_speeds in asv_console.py)." ;;
    clearance_guard.js) echo "  A SAFETY SUITE. Two halves, both written after a DriX passed a wharf at 0.6 m with a 5 m buffer set (Pago Pago, 2026-08-28). (1) THE TURN LADDER: a refused reversal is retried on the OTHER SIDE and then at the slow radius before it is given up, and if every rung refuses the pair is flagged UNSAFE rather than shipped as a straight 180 the hull cannot track. That straight-leg fallback is what put the boat on the pier - refusing the turn removed the only geometry steering it away from the thing that refused it - so if check 12 is red, someone has restored it. (2) THE RUNTIME GUARD: clearanceM is the boat's live distance to the keep-out model, built from blocked()'s own primitives so the number on the card cannot disagree with the rule the route was cleared against; the guard alarms inside the buffer and commands the LOW SPEED when closing. It must never command a heading (check 16) and must never command anything unless the boat is under autonomous command (check 14) - the RC transmitter is master and is the true failsafe. Note check 10b: slowing only reshapes a TEARDROP, never a semicircle, whose radius is the line spacing (turnWithRetry / clearanceGuard / clearanceM)." ;;
    port_slew.js)      echo "  The port change stopped being a visible journey, or stopped arriving. The slew must LAND on the destination at the original zoom on EVERY exit - end of flight, operator's hand on the chart, a second port picked mid-flight - because a chart stranded between two bases is worse than the teleport this replaced. It must be driven by setTimeout on Date.now() elapsed and NEVER requestAnimationFrame (rAF is suspended in an occluded window; that is the same trap that froze the window-split mirror and the card-size observer). Watch for: BOAT-follow losing its !slew guard (a port change respawns the sim boat at the new base, so frame one already reports the destination and follow would make the flight a one-frame teleport); a fractional zoom (it goes in the tile KEY and URL - the tiles do not exist); a lost antimeridian unwrap (Nome to Kamchatka flies the long way, across the Atlantic); and resetForNewArea no longer refetching the keep-out model, which is the defect this suite was written with - clearing nogo.ready makes BOTH arms of the re-extract in onState unreachable, so the console sits at the new base planning DIRECT in a sea it has never read (planSlew / slewAt / endSlew / resetForNewArea in static/asv.html)." ;;
    off_track.js)      echo "  The Intent card's 'off track' is measuring the wrong thing again. It is the SIGNED PERPENDICULAR from the leg being FLOWN (rr[idx-1] -> rr[idx]) and nothing else - never the range to the NEAREST survey line, which is what it used to be and which described a line the boat was not following on every transit, turn, Go-To and RTH. Watch for: a clamped t (point-to-segment is range-to-waypoint wearing the off-track label), a Math.abs or Math.hypot (the card's 'left' branch becomes unreachable, as it was for the whole of this console's life), or a nearest-line DISTANCE re-added to updateActiveLine - that function resolves an INDEX for the chart highlight and must publish no distance (offTrack / updateActiveLine in static/asv.html)." ;;
    turn_geometry.js)  echo "  A survey reversal no longer ends on the next line aligned, or asks the boat to hold a radius tighter than it can (teardropTurn in static/asv.html)." ;;
    roc_tracks.py)     echo "  A recovery point no longer lands where the offset says, the staged/active HOME gate leaks, a vessel-derived default stopped tracking the vessel, or one malformed NMEA sentence is dropping the whole GPS link (roc_tracks.py)." ;;
    ais_range.py)      echo "  The display range no longer filters the collected area correctly - filtering by box rather than range circle, filtering a LAKE, or exceeding what was collected (/api/ais + /api/ais/radius)." ;;
    live_speed.py)     echo "  A speed change is not reaching the vessel - speed over ground no longer follows the commanded speed (SimVcu.set_speed / Engine.set_speed / /api/cmd/speed)." ;;
    estop_chain.py)    echo "  THE SAFETY CHAIN. E-STOP is no longer reaching the vessel, no longer latching, or no longer letting go cleanly (Engine.set_estop / SimVcu.estop / the _require guards / /api/cmd/estop). Check 5b is the seam itself: the console's own flags can all look right while the boat is never told." ;;
    run_link_control.py) echo "  Run/link control broke: pause no longer holds the boat (or holds it but loses the leg - pause is NOT stop), transit skips its route sanitizing or arm gate, reset stopped being a clean sim power-cycle (or stopped REFUSING on a real link), or disconnect leaves a zombie link that still takes commands (Engine.pause/transit/reset/connect/disconnect in asv_console.py)." ;;
    home_spawn.py)     echo "  Home/spawn broke. sethome has TWO sources and each lands on its own check: an explicit lat/lon must be honoured exactly (2a) and NO position must still capture the boat's LIVE fix (2b) - never a dead link's stale status (Engine.set_home's guards + connect()'s status clear). Half a coordinate must refuse rather than fall back (2c), and a malformed one must be a refusal that NAMES the rule (2d) - a bare float() would be turned into a generic 500 by _dispatch_post's catch-all, which is the handler falling over, not refusing. NOTE 2a asserts the OPPOSITE of what this suite said before 2026-08-08, when a supplied position was discarded; that reversal was the operator's explicit call - read the docstring before 'restoring' it. If this suite ABORTS at 2e rather than failing a check, the console STOPPED ANSWERING partway through - a malformed home reached the engine, which is what the range guard in Engine.set_home exists to prevent. Also: RTH no longer closes on home, or spawn stopped validating / stopped being a full power-cycle AT the point (the /api/cmd/spawn handler + Engine.reset)." ;;
    energy_chartinfo.py) echo "  Energy override or chart info broke: the override no longer snaps/holds the tank (SimVcu.set_unlimited_energy + the tick's _unlimited_energy branch), the engine's state() force-fill is gone (the only layer when DISCONNECTED), or /api/chartinfo stopped serving its exact-key cache / answering a malformed bbox with the 400 usage line (fetch_chart_info / _serve_chartinfo)." ;;
    enc_extract.py)    echo "  The ENC feature extract broke: a malformed bbox is no longer a 400 with the ENC usage, the cache stopped answering (or started REWRITING itself on read), the per-request shallow retag is gone/baked-in/off-by-one at the boundary, or a SHARED helper regressed - _bbox_key and _bbox_from_query serve BOTH /api/enc and /api/chartinfo, so check the twin too (fetch_enc_features / _serve_enc in asv_console.py)." ;;
    env_water.py)      echo "  Env/water broke: a manual env override no longer REACHES the running boat (EnvMonitor.field / env_set_kn), disabling no longer returns it to calm (every suite that assumes calm water inherits that), the field-merge/clear/auto semantics regressed, or a non-numeric value is a dropped connection again instead of a 400 - BOTH branches sit before the dispatch try, so their guards are local (the /api/env + /api/waterlevel handlers in _dispatch_post)." ;;
    log_routes.py)     echo "  The log routes broke: a client logevent with a data key named kind/self drops the connection again (the rename in the /api/logevent handler - that branch has NO dispatch-try net), the record shape stopped being FLAT (playback reads it), /api/logs lost the live session, or safe_log_path serves something that is not a bare asv_*.jsonl inside LOG_DIR. NOTE this suite runs the console WITH logging on - every other harness passes --no-log, which masks the logevent branch entirely." ;;
    data_routes.py)    echo "  A data route broke: the vessel switch lost its SAFE gate (409 while armed) or stopped respawning (the energy gauge no longer flips), the comms password LEAKS (echoed by the GET, written to comms_config.json, or unredacted in the session log - three separate paths), the mode whitelist stores garbage, /api/tide stopped answering, or the ROC HTTP face lost an error mapping (unknown op 400 / bad request 400 / feed-unknown 404). Runs WITH logging on for the redaction check." ;;
    ais_error_frames.py) echo "  The upstream error frame is being swallowed again: an {error:...} text frame from aisstream must surface as the source note (state error), survive the quiet-box timeout re-stamp, and clear when real data flows (_frame_error + the read loop in ais_service.py - CRLF file). Before the fix a dead key read as connected, zero reports, forever." ;;
    completion_modes.py) echo "  The operator's END-OF-PLAN SETTING and the completion of the run IN PROGRESS have been conflated again - a behaviour is writing the setting, or a plan run is ignoring it (plan_completion / Engine.run_completion)." ;;
    docs_valid.py)     echo "  A generated document is not a package a reader will open, or a code block did not reach the page. Rebuild with: cd tools && node build_docs.js  - a helper that returns a LIST must be flattened (write() in docx_kit.js)." ;;
    tide_note.py)      echo "  The tide card is repeating one upstream failure as two sentences again, or has stopped naming which series were lost (tide_note in asv_console.py)." ;;
    http_contract.py)  echo "  A POST handler is breaking _dispatch_post's (code, obj) contract, a GET handler has a path that commits NO response, or something raised while serving. A handler can answer the client CORRECTLY and still take down its thread, so the check on the server's own log is the one no client check can see." ;;
    *)                 echo "  See the suite's own docstring for what it guards and how to fix it." ;;
  esac
}

fail=0
have_node=0; command -v node   >/dev/null 2>&1 && have_node=1
have_py=0;   command -v python >/dev/null 2>&1 && have_py=1
[ "$have_node" -eq 1 ] || echo "pre-commit: node not found - skipping the JavaScript suites (install Node to enable them)."
[ "$have_py"   -eq 1 ] || echo "pre-commit: python not found - skipping the Python suites."

# Run EVERY suite and report every failure rather than stopping at the first - two broken
# invariants are worth knowing about in one pass. A suite that CRASHES is treated exactly
# as loudly as one that fails a check: a non-zero exit is a non-zero exit, and "printed no
# FAIL line" must never read as "passed".
for suite in tests/*.js tests/*.py; do
  [ -e "$suite" ] || continue
  name=$(basename "$suite")
  case "$suite" in
    *.js) [ "$have_node" -eq 1 ] || continue; runner=node   ;;
    *.py) [ "$have_py"   -eq 1 ] || continue; runner=python ;;
  esac
  echo "pre-commit: $name ..."
  if ! $runner "$suite"; then
    echo ""
    echo "pre-commit: $name FAILED."
    advice_for "$name"
    fail=1
  fi
done

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "pre-commit: commit blocked. Override with:  git commit --no-verify"
  exit 1
fi
exit 0
