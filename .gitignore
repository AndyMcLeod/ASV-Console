*.part
# A mutation runner's pristine-source sidecar. It exists only WHILE a run is in flight; if
# you find one at rest, that run DIED and the source it guards is suspect - restore from it
# before trusting a green suite. Ignored so a killed run can never be committed.
*.mutorig

# proprietary vendor material - do not publish
*.pdf
reference/
recordings/

# stray screenshots dropped in the project dir
Screenshots/

# AIS: local aisstream.io API key (never commit)
ais_key.txt

# doc tooling deps (reinstall with: cd tools && npm install)
node_modules/

# ROC placements are per-operator session state, not project config
roc_config.json

# Office lock files (~$xxx) while a doc/deck is open
~$*

# NOAA OFS current-model cache (fetched grids, megabytes - never committed)
ofs_cache/
